{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trang Trai Hang Soc",
  "version": "1.0.0",
  "identifier": "vn.hpvn.hangsoc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trang Trại Hang Sóc & Thung Lũng Hogsmeade",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "public/icons/icon-192.png",
      "public/icons/icon-512.png"
    ]
  }
}
